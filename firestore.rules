rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bestehendes Nutzerprofil (siehe AuthRepository.saveUserProfile).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kennzeichen-Sammelspiel: persönliche Funde je Land, nur für den
    // jeweiligen Nutzer lesbar/schreibbar.
    match /users/{userId}/discoveries/{country} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kennzeichen-Sammelspiel: gemeinsame "alle Spieler zusammen"-Funde je
    // Land. Jeder eingeloggte Spieler darf lesen und Codes ergänzen
    // (arrayUnion), aber nie welche entfernen oder das Dokument ersetzen.
    match /globalDiscoveries/{country} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.codes.hasAll(resource.data.codes);
    }

    // Update-Prüfung: nur lesbar, Schreiben ausschließlich über die
    // Firebase Console / Admin-SDK.
    match /app_config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
