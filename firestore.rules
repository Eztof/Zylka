rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bestehendes Nutzerprofil (siehe AuthRepository.saveUserProfile).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kennzeichen-Sammelspiel: ein Dokument pro Fund (wer/was/wann/wo).
    // Jeder eingeloggte Nutzer darf den ganzen Log lesen (persönliche und
    // globale Fortschritte sowie der Verlauf werden clientseitig daraus
    // abgeleitet). Anlegen darf man nur Funde, die auf einen selbst
    // eingetragen sind; Ändern oder Löschen ist nicht vorgesehen - der Log
    // ist bewusst nur anhängbar (Historie bleibt unverändert erhalten).
    match /discoveries/{discoveryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Update-Prüfung: nur lesbar, Schreiben ausschließlich über die
    // Firebase Console / Admin-SDK.
    match /app_config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Notenspiegelrechner: persönliche Schwellen-Einstellungen je Nutzer.
    match /notenspiegel_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pflanzen (Gießplaner): Töpfe und Pflanzen werden von allen eingeloggten
    // Nutzern gemeinsam gepflegt (geteilter Garten, z. B. für ein ganzes
    // Haushalts-Konto) - jeder sieht und bearbeitet alle Töpfe/Pflanzen, nicht
    // nur die eigenen.
    match /pots/{potId} {
      allow read, write: if request.auth != null;
    }
    match /plants/{plantId} {
      allow read, write: if request.auth != null;
    }

    // Gieß-Log: append-only wie discoveries (nie update/delete), für alle
    // eingeloggten Nutzer lesbar - jeder sieht, wer wann gegossen hat. Anlegen
    // darf man nur Einträge, die auf einen selbst eingetragen sind.
    match /waterings/{wateringId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Wetter-Cache je Nutzer (Open-Meteo-Antworten, max. alle 3 Stunden neu abgerufen).
    match /weather_cache/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bluetooth-Sensoren (TP357): wie pots/plants geteilt zwischen allen eingeloggten
    // Nutzern.
    match /sensors/{sensorId} {
      allow read, write: if request.auth != null;
    }

    // Sensor-Messwerte: append-only wie waterings, für alle eingeloggten Nutzer lesbar.
    // Anlegen darf man nur Einträge, die auf einen selbst eingetragen sind.
    match /sensor_readings/{readingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Regelkalender: wie pots/plants/sensors geteilt zwischen allen eingeloggten Nutzern -
    // Werte werden nachträglich korrigiert, deshalb kein Append-only-Muster.
    match /regel_eintraege/{eintragId} {
      allow read, write: if request.auth != null;
    }

    // Hochzeitsplaner: wie pots/plants/sensors/regel_eintraege geteilt zwischen allen
    // eingeloggten Nutzern (dir und deiner Verlobten) - alles nachträglich korrigierbar,
    // deshalb kein Append-only-Muster.
    match /hochzeit_termine/{terminId} {
      allow read, write: if request.auth != null;
    }
    match /hochzeit_gaeste/{gastId} {
      allow read, write: if request.auth != null;
    }
    match /hochzeit_dienstleister/{dienstleisterId} {
      allow read, write: if request.auth != null;
    }
    match /hochzeit_dokumente/{dokumentId} {
      allow read, write: if request.auth != null;
    }
  }
}
