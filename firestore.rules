rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bestehendes Nutzerprofil (siehe AuthRepository.saveUserProfile).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kennzeichen-Sammelspiel: ein Dokument pro Fund (wer/was/wann/wo).
    // Jeder eingeloggte Nutzer darf den ganzen Log lesen (persönliche und
    // globale Fortschritte sowie der Verlauf werden clientseitig daraus
    // abgeleitet). Anlegen darf man nur Funde, die auf einen selbst
    // eingetragen sind; Ändern oder Löschen ist nicht vorgesehen - der Log
    // ist bewusst nur anhängbar (Historie bleibt unverändert erhalten).
    match /discoveries/{discoveryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Update-Prüfung: nur lesbar, Schreiben ausschließlich über die
    // Firebase Console / Admin-SDK.
    match /app_config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Notenspiegelrechner: persönliche Schwellen-Einstellungen je Nutzer.
    match /notenspiegel_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
