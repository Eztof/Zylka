<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material3-Theme mit eigener Markenfarbe. Bewusst NICHT "DayNight",
         sondern fest auf Hell gestellt - die App soll den System-Dunkelmodus
         ignorieren, damit z. B. Textfarben nicht unerwartet mit dem
         Hintergrund verschmelzen. NoActionBar, weil jeder Screen eine eigene
         MaterialToolbar mitbringt. -->
    <style name="Theme.Zylka" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container</item>

        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_on_background</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>

        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_on_error</item>
        <item name="colorErrorContainer">@color/brand_error_container</item>
        <item name="colorOnErrorContainer">@color/brand_on_error_container</item>

        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Toolbar-Look: Marke statt Standard-Surface, damit der App-Bereich klar
         als "eine App" erkennbar ist. -->
    <style name="Widget.Zylka.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextColor">@color/brand_on_primary</item>
        <item name="subtitleTextColor">@color/brand_on_primary</item>
        <item name="android:theme">@style/ThemeOverlay.Zylka.Toolbar</item>
    </style>

    <style name="ThemeOverlay.Zylka.Toolbar" parent="">
        <item name="colorControlNormal">@color/brand_on_primary</item>
        <item name="colorOnSurface">@color/brand_on_primary</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_primary</item>
        <item name="actionMenuTextColor">@color/brand_on_primary</item>
    </style>

    <!-- Wiederkehrende Karten-Optik für Feature-/Aktions-Kacheln. -->
    <style name="Widget.Zylka.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/brand_outline_variant</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="rippleColor">@color/brand_primary_container</item>
    </style>

    <style name="Widget.Zylka.Card.Compact" parent="Widget.Zylka.Card">
        <item name="cardCornerRadius">14dp</item>
    </style>
</resources>
