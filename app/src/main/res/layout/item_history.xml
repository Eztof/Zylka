<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Zylka.Card.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <include
            android:id="@+id/plate_badge"
            layout="@layout/view_plate_badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_region_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/brand_on_surface"
                tools:text="München" />

            <TextView
                android:id="@+id/text_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/brand_on_surface_variant"
                tools:text="von Du · vor 3 Min." />
        </LinearLayout>

        <ImageView
            android:id="@+id/icon_location"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/kennzeichen_history_location"
            android:src="@drawable/ic_location"
            android:visibility="gone"
            app:tint="@color/brand_outline" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
