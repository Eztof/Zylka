<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Zylka.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true" />

            <ProgressBar
                android:id="@+id/progress_loading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/group_progress"
                style="@style/Widget.Zylka.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/kennzeichen_progress_personal"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_on_surface_variant" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_personal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        app:indicatorColor="@color/brand_primary"
                        app:trackColor="@color/brand_surface_variant"
                        app:trackCornerRadius="6dp" />

                    <TextView
                        android:id="@+id/text_progress_personal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/brand_on_surface_variant"
                        tools:text="12 von 401 gefunden" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/kennzeichen_progress_global"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/brand_on_surface_variant" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_global"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        app:indicatorColor="@color/brand_secondary"
                        app:trackColor="@color/brand_surface_variant"
                        app:trackCornerRadius="6dp" />

                    <TextView
                        android:id="@+id/text_progress_global"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/brand_on_surface_variant"
                        tools:text="88 von 401 gefunden" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/label_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="@string/kennzeichen_actions_label"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/brand_on_background" />

            <include
                android:id="@+id/card_entry"
                layout="@layout/item_action_card" />

            <include
                android:id="@+id/card_collection"
                layout="@layout/item_action_card"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/card_map"
                layout="@layout/item_action_card"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/card_global"
                layout="@layout/item_action_card"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/card_history"
                layout="@layout/item_action_card"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
