<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Zylka.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Standesamt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_title_standesamt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/brand_on_background"
                    tools:text="Standesamt" />

                <ImageView
                    android:id="@+id/button_add_standesamt"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/action_add"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_add_circle"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_empty_standesamt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hochzeit_termin_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/brand_outline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_standesamt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_termin" />

            <!-- Kirche -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_title_kirche"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/brand_on_background"
                    tools:text="Kirche" />

                <ImageView
                    android:id="@+id/button_add_kirche"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/action_add"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_add_circle"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_empty_kirche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hochzeit_termin_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/brand_outline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_kirche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_termin" />

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_title_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/brand_on_background"
                    tools:text="Location" />

                <ImageView
                    android:id="@+id/button_add_location"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/action_add"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_add_circle"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_empty_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hochzeit_termin_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/brand_outline" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_termin" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
