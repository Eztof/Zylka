<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Zylka.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="2dp"
        android:title="@string/feature_regelkalender" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_prev_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/regel_action_prev_month"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/brand_on_surface" />

            <TextView
                android:id="@+id/text_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/brand_on_surface"
                tools:text="August 2026" />

            <ImageView
                android:id="@+id/button_next_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/regel_action_next_month"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/brand_on_surface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_mo"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_di"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_mi"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_do"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_fr"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_sa"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/regel_weekday_so"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_outline" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="35"
            tools:listitem="@layout/item_regel_day"
            tools:spanCount="7" />
    </LinearLayout>
</LinearLayout>
