<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Zylka.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:elevation="2dp"
        tools:title="Wohnzimmer" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status: aktueller Wert + Komfort-Gauge, an das TP357-Karten-Layout der
                 ThermoPro-App angelehnt, hier in unserem Farbschema. -->
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Zylka.Card.Compact">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/brand_outline" />

                        <TextView
                            android:id="@+id/text_mac"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/brand_outline"
                            tools:text="AA:BB:CC:DD:EE:FF" />

                        <TextView
                            android:id="@+id/text_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/brand_outline"
                            tools:text="vor 2 Std." />

                        <ImageView
                            android:id="@+id/button_pull"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/sensor_detail_action_pull"
                            android:focusable="true"
                            android:padding="3dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/brand_primary" />

                        <ProgressBar
                            android:id="@+id/progress_pull"
                            style="?android:attr/progressBarStyle"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_thermometer"
                                app:tint="@color/brand_error" />

                            <TextView
                                android:id="@+id/text_temperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="@color/brand_on_surface"
                                tools:text="21,4 °C" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sensor_stat_temperature"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/brand_on_surface_variant" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="52dp"
                            android:background="@color/brand_outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_heat_index"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="26dp"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="@color/brand_secondary"
                                tools:text="21,0 °C" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sensor_stat_heat_index"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/brand_on_surface_variant" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="52dp"
                            android:background="@color/brand_outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_water_drop"
                                app:tint="@color/brand_tertiary" />

                            <TextView
                                android:id="@+id/text_humidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="@color/brand_on_surface"
                                tools:text="48 %" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sensor_stat_humidity"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/brand_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.oliver.zylka.plants.ComfortGaugeView
                        android:id="@+id/gauge_humidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_load_history"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_detail_action_load_history"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_history" />

                <ProgressBar
                    android:id="@+id/progress_history"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sensor_detail_load_history_caption"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/brand_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/sensor_detail_label_range"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/brand_on_surface" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_range_hour"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_range_hour" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_range_day"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/sensor_range_day" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_range_week"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_range_week" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_range_month"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_range_month" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_range_year"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_range_year" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zylka.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sensor_chart_title_temperature"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/brand_on_surface" />

                        <TextView
                            android:id="@+id/text_temperature_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/brand_outline"
                            tools:text="Max.: 29,4 °C · Min.: 25,3 °C" />
                    </LinearLayout>

                    <com.oliver.zylka.plants.SensorHistoryChartView
                        android:id="@+id/chart_temperature"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/text_temperature_chart_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_chart_empty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/brand_outline"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Zylka.Card.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sensor_chart_title_humidity"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/brand_on_surface" />

                        <TextView
                            android:id="@+id/text_humidity_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/brand_outline"
                            tools:text="Max.: 46 % · Min.: 26 %" />
                    </LinearLayout>

                    <com.oliver.zylka.plants.SensorHistoryChartView
                        android:id="@+id/chart_humidity"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/text_humidity_chart_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_chart_empty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/brand_outline"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/sensor_detail_label_history"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/brand_on_surface" />

            <TextView
                android:id="@+id/text_history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sensor_detail_history_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/brand_on_surface_variant"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_sensor_reading" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
