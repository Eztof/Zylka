<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional: für das "wo" beim Eintragen eines Kennzeichen-Fundes. Die App
         fragt einmalig danach und funktioniert auch ohne diese Berechtigung. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Abfallkalender: Erinnerungen als Benachrichtigung, auch wenn die App
         geschlossen ist. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pflanzen: TP357-Bluetooth-Sensoren auslesen (nur aktiver Scan bei Nutzeraktion,
         keine Dauerverbindung). neverForLocation: wir leiten aus den Scan-Ergebnissen nie
         den Standort ab, nur Name/MAC/Herstellerdaten - ohne dieses Flag verlangt Android
         (ab API 31, hier minSdk 36 also immer) zusätzlich ACCESS_FINE_LOCATION UND
         eingeschaltete Standortdienste, sonst liefert der Scan wortlos keine Ergebnisse. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Hochzeitsplaner-Galerie: prüfen, ob eine App PDFs anzeigen kann, bevor wir sie per
         ACTION_VIEW dorthin schicken (ab API 30 sonst wortlos "keine App gefunden"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zylka">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Zylka">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".kennzeichen.KennzeichenHomeActivity"
            android:exported="false" />

        <activity
            android:name=".kennzeichen.KennzeichenEntryActivity"
            android:exported="false" />

        <activity
            android:name=".kennzeichen.KennzeichenCollectionActivity"
            android:exported="false" />

        <activity
            android:name=".kennzeichen.KennzeichenMapActivity"
            android:exported="false" />

        <activity
            android:name=".kennzeichen.KennzeichenHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".waste.WasteCalendarActivity"
            android:exported="false" />

        <activity
            android:name=".notenspiegel.NotenspiegelActivity"
            android:exported="false" />

        <activity
            android:name=".notenspiegel.NotenspiegelSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".plants.PlantsHomeActivity"
            android:exported="false" />

        <activity
            android:name=".plants.PotEditActivity"
            android:exported="false" />

        <activity
            android:name=".plants.PlantEditActivity"
            android:exported="false" />

        <activity
            android:name=".plants.PotDetailActivity"
            android:exported="false" />

        <activity
            android:name=".plants.SensorsActivity"
            android:exported="false" />

        <activity
            android:name=".plants.SensorEditActivity"
            android:exported="false" />

        <activity
            android:name=".plants.SensorDetailActivity"
            android:exported="false" />

        <activity
            android:name=".plants.SensorDiagnosticActivity"
            android:exported="false" />

        <activity
            android:name=".regel.RegelkalenderActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.HochzeitHomeActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.TerminUebersichtActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.GastListeActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.GastEditActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.DienstleisterListeActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.DienstleisterEditActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.GalerieActivity"
            android:exported="false" />

        <activity
            android:name=".hochzeit.BildAnsichtActivity"
            android:exported="false" />

        <receiver
            android:name=".waste.WasteAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".waste.WasteBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".plants.PlantAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".plants.PlantBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
